        </mxCell>
        <mxCell id="q0iDizheb-PmmOYjfkxu-7" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Prompt when the user first picks up the phone.&lt;/font&gt;&lt;div style=&quot;font-size: 15px;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;E.g., when user turns their screen on&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
