        <mxCell id="q0iDizheb-PmmOYjfkxu-11" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Prompt when the user is on applications users selected&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;(&lt;/font&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;such as Instagram or YouTube)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
