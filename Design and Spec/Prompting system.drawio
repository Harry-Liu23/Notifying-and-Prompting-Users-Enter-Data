        <mxCell id="q0iDizheb-PmmOYjfkxu-1" value="&lt;span style=&quot;font-size: 15px;&quot;&gt;Every 1 or 2 hours (depending on users&#39; settings), only one notification would be triggered; users are allowed to choose start time and end time of notifications.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
