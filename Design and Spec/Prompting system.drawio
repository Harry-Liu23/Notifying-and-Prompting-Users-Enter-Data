        <mxCell id="q0iDizheb-PmmOYjfkxu-16" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Clicking the prompt takes user to a pop-up window with input fields&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
